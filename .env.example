# ─── Required ────────────────────────────────────────────────────────────────

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys).
# Server-side only. It needs ElevenAgents (agents, tools, conversations) and voices read access.
ELEVENLABS_API_KEY=

# Password for the admin at /admin.
ADMIN_PASSWORD=

# Signs the admin session cookie. 32+ random characters: `openssl rand -base64 48`
SESSION_SECRET=

# ─── Handoff reports (optional) ──────────────────────────────────────────────

# Claude writes a handoff after each interview call. Without a key, everything
# else works and the report panel says how to turn it on.
# ANTHROPIC_API_KEY=
# REPORT_MODEL=claude-opus-5-5

# ─── Database ────────────────────────────────────────────────────────────────

# Empty: a local SQLite file at data/voice.db (nothing to set up).
# postgres://… : Postgres, e.g. Supabase (Connect → Transaction pooler) or Neon.
# libsql://…   : Turso, with DATABASE_AUTH_TOKEN.
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# ─── Optional ────────────────────────────────────────────────────────────────

# Public base URL used in share links. Defaults to the URL you open the admin from.
# PUBLIC_URL=https://voice.example.com

# Who the agents say they work with, and how to pronounce it.
# ORG_NAME=PostScarcity AI
# ORG_NAME_SPOKEN=Post Scarcity A.I.

# Agent defaults. Each agent can pick its own voice and LLM in the admin.
# ELEVENLABS_DEFAULT_VOICE_ID=
# ELEVENLABS_DEFAULT_LLM=claude-sonnet-5-5
# ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# For data residency, point at a regional API host.
# ELEVENLABS_API_BASE=https://api.eu.residency.elevenlabs.io

# Post-call webhook secret (see README). Without it the webhook route is off and
# sessions sync from the API when they end or when you open them.
# ELEVENLABS_WEBHOOK_SECRET=

# How many calls one share link can start per 24 hours.
# SESSIONS_PER_LINK_PER_DAY=10
